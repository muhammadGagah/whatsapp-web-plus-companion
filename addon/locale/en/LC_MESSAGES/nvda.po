#. Translators: Category name shown in NVDA's Input Gestures dialog.
msgid "WhatsApp Companion"
msgstr "WhatsApp Companion"

msgid "Answer native WhatsApp call"
msgstr "Answer native WhatsApp call"

msgid "Decline native WhatsApp call"
msgstr "Decline native WhatsApp call"

msgid "The call action could not be confirmed. Check the WhatsApp call window."
msgstr "The call action could not be confirmed. Check the WhatsApp call window."

msgid "Capture native WhatsApp call diagnostics"
msgstr "Capture native WhatsApp call diagnostics"

msgid "Call control mapping is not available yet. No call action was performed."
msgstr "Call control mapping is not available yet. No call action was performed."

msgid "Call diagnostics are unavailable in this NVDA session."
msgstr "Call diagnostics are unavailable in this NVDA session."

msgid "Focus the WhatsApp call window before capturing diagnostics."
msgstr "Focus the WhatsApp call window before capturing diagnostics."

msgid "Call diagnostics could not be captured."
msgstr "Call diagnostics could not be captured."

msgid "Call diagnostics written to the NVDA log. Call controls were not activated."
msgstr "Call diagnostics written to the NVDA log. Call controls were not activated."

#, python-brace-format
msgid "Skipped WhatsApp Web Plus braille announcements: {count}."
msgstr "Skipped WhatsApp Web Plus braille announcements: {count}."

msgid "WhatsApp Web Plus announcement cleared."
msgstr "WhatsApp Web Plus announcement cleared."

#. Translators: Submenu label shown under NVDA's Tools menu.
msgid "&WhatsApp Companion"
msgstr "&WhatsApp Companion"

msgid "Launch or force close Microsoft Store WhatsApp, and manage WhatsApp Web Plus userscript updates."
msgstr "Launch or force close Microsoft Store WhatsApp, and manage WhatsApp Web Plus userscript updates."

#. Translators: Tools submenu command. The ampersand marks the mnemonic.
msgid "Launch WhatsApp &Stable with WhatsApp Companion"
msgstr "Launch WhatsApp &Stable with WhatsApp Companion"

#. Translators: Command description in NVDA's Input Gestures dialog.
msgid "Launch WhatsApp Stable with WhatsApp Companion"
msgstr "Launch WhatsApp Stable with WhatsApp Companion"

#. Translators: Tools submenu command. The ampersand marks the mnemonic.
msgid "Launch WhatsApp &Beta with WhatsApp Companion"
msgstr "Launch WhatsApp &Beta with WhatsApp Companion"

#. Translators: Command description in NVDA's Input Gestures dialog.
msgid "Launch WhatsApp Beta with WhatsApp Companion"
msgstr "Launch WhatsApp Beta with WhatsApp Companion"

#. Translators: Tools submenu command. The ampersand marks the mnemonic.
msgid "Launch the &last selected WhatsApp channel with WhatsApp Companion"
msgstr "Launch the &last selected WhatsApp channel with WhatsApp Companion"

msgid "Launch the last selected WhatsApp channel with WhatsApp Companion"
msgstr "Launch the last selected WhatsApp channel with WhatsApp Companion"

#. Translators: Destructive Tools submenu command. The ampersand marks the mnemonic.
msgid "Force close &all Microsoft Store WhatsApp processes..."
msgstr "Force close &all Microsoft Store WhatsApp processes..."

msgid "Force close all running Microsoft Store WhatsApp Stable and Beta processes"
msgstr "Force close all running Microsoft Store WhatsApp Stable and Beta processes"

#. Translators: Tools submenu command. The ellipsis is required because activation may show a confirmation dialog.
msgid "Diagnose and repair WebView2 &policy permissions..."
msgstr "Diagnose and repair WebView2 &policy permissions..."

msgid "Check the per-user WebView2 policy permissions and offer a repair when the Companion cannot use them"
msgstr "Check the per-user WebView2 policy permissions and offer a repair when the Companion cannot use them"

#. Translators: Tools submenu command. The ampersand marks the mnemonic.
msgid "&Report the last WhatsApp Companion result"
msgstr "&Report the last WhatsApp Companion result"

#. Translators: Command description in NVDA's Input Gestures dialog.
msgid "Report the last WhatsApp Companion result"
msgstr "Report the last WhatsApp Companion result"

#. Translators: Tools submenu command. The ampersand marks the mnemonic.
msgid "&Check for WhatsApp Web Plus userscript updates"
msgstr "&Check for WhatsApp Web Plus userscript updates"

msgid "Check for WhatsApp Web Plus userscript updates and automatically install a newer or changed official version in the Companion"
msgstr "Check for WhatsApp Web Plus userscript updates and automatically install a newer or changed official version in the Companion"

msgid "Some WhatsApp Web Plus announcements were skipped while reconnecting."
msgstr "Some WhatsApp Web Plus announcements were skipped while reconnecting."

msgid "The Companion is still cleaning up after the previous launch. Wait a moment and try again. If the problem continues, restart NVDA."
msgstr "The Companion is still cleaning up after the previous launch. Wait a moment and try again. If the problem continues, restart NVDA."

#. Translators: Spoken and brailled after the companion has loaded successfully.
#, python-brace-format
msgid "WhatsApp {channel} is running with WhatsApp Companion."
msgstr "WhatsApp {channel} is running with WhatsApp Companion."

#, python-brace-format
msgid "WhatsApp {channel} is still loading with WhatsApp Companion. Please wait."
msgstr "WhatsApp {channel} is still loading with WhatsApp Companion. Please wait."

#. Translators: Spoken and brailled when a launch command is invoked while a session is active.
msgid "WhatsApp Companion is already running. Close WhatsApp first."
msgstr "WhatsApp Companion is already running. Close WhatsApp first."

#. Translators: Spoken and brailled when the user closes WhatsApp normally.
#, python-brace-format
msgid "WhatsApp {channel} was closed. WhatsApp Companion stopped."
msgstr "WhatsApp {channel} was closed. WhatsApp Companion stopped."

#. Translators: Recovery message when WhatsApp was already open before the companion started.
msgid "WhatsApp is already running. Close it normally and try again."
msgstr "WhatsApp is already running. Close it normally and try again."

#. Translators: Spoken and brailled when NVDA stops an in-progress launch.
msgid "WhatsApp Companion launch was cancelled."
msgstr "WhatsApp Companion launch was cancelled."

#. Translators: Status when another force-close request is made while one is running.
msgid "WhatsApp is already being force closed. Wait for the result."
msgstr "WhatsApp is already being force closed. Wait for the result."

msgid "Neither WhatsApp Stable nor WhatsApp Beta from Microsoft Store was running."
msgstr "Neither WhatsApp Stable nor WhatsApp Beta from Microsoft Store was running."

#, python-brace-format
msgid "The Companion force closed every running Microsoft Store WhatsApp Stable and Beta process. It closed {closedCount} in total."
msgstr "The Companion force closed every running Microsoft Store WhatsApp Stable and Beta process. It closed {closedCount} in total."

#, python-brace-format
msgid "The Companion force closed {closedCount} Microsoft Store WhatsApp processes, but WhatsApp {remainingChannels} may still be running. Restart Windows before launching the Companion again."
msgstr "The Companion force closed {closedCount} Microsoft Store WhatsApp processes, but WhatsApp {remainingChannels} may still be running. Restart Windows before launching the Companion again."

#, python-brace-format
msgid "The Companion could not force close WhatsApp {remainingChannels} from Microsoft Store or confirm that it had closed. Restart Windows before launching the Companion again."
msgstr "The Companion could not force close WhatsApp {remainingChannels} from Microsoft Store or confirm that it had closed. Restart Windows before launching the Companion again."

msgid "The Companion cannot force close WhatsApp in this NVDA session. Unlock Windows and run NVDA normally, not as administrator."
msgstr "The Companion cannot force close WhatsApp in this NVDA session. Unlock Windows and run NVDA normally, not as administrator."

#. Translators: Recovery message after renderer reconnection has failed.
msgid "The companion connection was lost. Close WhatsApp, then launch it again."
msgstr "The companion connection was lost. Close WhatsApp, then launch it again."

#. Translators: Recovery message for locked, secure, read-only, or elevated NVDA contexts.
msgid "Unlock Windows and run a normal, non-administrator copy of NVDA, then try again."
msgstr "Unlock Windows and run a normal, non-administrator copy of NVDA, then try again."

#. Translators: Recovery message when the selected Microsoft Store WhatsApp channel is unavailable.
msgid "Install the selected WhatsApp channel from Microsoft Store, then try again."
msgstr "Install the selected WhatsApp channel from Microsoft Store, then try again."

msgid "The Companion could not safely access the Windows Registry. Restart NVDA and try again. If the problem continues, report the error."
msgstr "The Companion could not safely access the Windows Registry. Restart NVDA and try again. If the problem continues, report the error."

msgid "Windows could not confirm whether another Companion operation was using the Registry. Restart NVDA and try again. If the problem continues, report the error."
msgstr "Windows could not confirm whether another Companion operation was using the Registry. Restart NVDA and try again. If the problem continues, report the error."

msgid "Windows blocked access to the computer-wide WebView2 policy setting. Contact your administrator."
msgstr "Windows blocked access to the computer-wide WebView2 policy setting. Contact your administrator."

msgid "The computer-wide WebView2 policy setting could not be checked. Contact your administrator or report the error."
msgstr "The computer-wide WebView2 policy setting could not be checked. Contact your administrator or report the error."

msgid "A Windows policy controls the WebView2 launch settings for this WhatsApp channel. The Companion cannot override the policy, so it left the settings unchanged. Contact your administrator for help."
msgstr "A Windows policy controls the WebView2 launch settings for this WhatsApp channel. The Companion cannot override the policy, so it left the settings unchanged. Contact your administrator for help."

msgid "A Windows policy controls the WebView2 launch settings for all applications. The Companion cannot override the policy, so it left the settings unchanged. Contact your administrator for help."
msgstr "A Windows policy controls the WebView2 launch settings for all applications. The Companion cannot override the policy, so it left the settings unchanged. Contact your administrator for help."

msgid "Windows blocked access to the per-user WebView2 policy setting required by the Companion. In NVDA Tools, open WhatsApp Companion and choose Diagnose and repair WebView2 policy permissions, then try again."
msgstr "Windows blocked access to the per-user WebView2 policy setting required by the Companion. In NVDA Tools, open WhatsApp Companion and choose Diagnose and repair WebView2 policy permissions, then try again."

msgid "The per-user WebView2 policy setting could not be read. Close WhatsApp and try again. If this continues, report the error."
msgstr "The per-user WebView2 policy setting could not be read. Close WhatsApp and try again. If this continues, report the error."

msgid "An existing per-user WebView2 launch setting has an unsupported data type. The Companion did not change it. Review the setting manually."
msgstr "An existing per-user WebView2 launch setting has an unsupported data type. The Companion did not change it. Review the setting manually."

msgid "A remote-debugging launch argument already exists for this WhatsApp channel. The Companion did not overwrite it. Permission repair does not remove settings the Companion cannot prove it owns."
msgstr "A remote-debugging launch argument already exists for this WhatsApp channel. The Companion did not overwrite it. Permission repair does not remove settings the Companion cannot prove it owns."

msgid "Windows did not allow the Companion to create or update its temporary per-user WebView2 launch setting. WhatsApp was not launched. Run Diagnose and repair WebView2 policy permissions from the Companion submenu, then try again."
msgstr "Windows did not allow the Companion to create or update its temporary per-user WebView2 launch setting. WhatsApp was not launched. Run Diagnose and repair WebView2 policy permissions from the Companion submenu, then try again."

msgid "The temporary per-user WebView2 launch setting could not be created or updated. WhatsApp was not launched. Close WhatsApp and try again. If this continues, report the error."
msgstr "The temporary per-user WebView2 launch setting could not be created or updated. WhatsApp was not launched. Close WhatsApp and try again. If this continues, report the error."

msgid "The temporary per-user WebView2 launch setting could not be written. WhatsApp was not launched. Close WhatsApp and try again. If this continues, report the error."
msgstr "The temporary per-user WebView2 launch setting could not be written. WhatsApp was not launched. Close WhatsApp and try again. If this continues, report the error."

msgid "The temporary WebView2 launch setting could not be verified after it was written. Close WhatsApp and try again."
msgstr "The temporary WebView2 launch setting could not be verified after it was written. Close WhatsApp and try again."

msgid "The Companion could not restore the previous per-user WebView2 setting. Close WhatsApp now, then run Diagnose and repair WebView2 policy permissions. The Companion will retry the saved restoration before another launch."
msgstr "The Companion could not restore the previous per-user WebView2 setting. Close WhatsApp now, then run Diagnose and repair WebView2 policy permissions. The Companion will retry the saved restoration before another launch."

msgid "The previous per-user WebView2 setting could not be opened for restoration. Close WhatsApp and report the error."
msgstr "The previous per-user WebView2 setting could not be opened for restoration. Close WhatsApp and report the error."

msgid "The Companion could not remove its temporary per-user WebView2 setting. Close WhatsApp now, then run Diagnose and repair WebView2 policy permissions. The Companion will retry the saved restoration before another launch."
msgstr "The Companion could not remove its temporary per-user WebView2 setting. Close WhatsApp now, then run Diagnose and repair WebView2 policy permissions. The Companion will retry the saved restoration before another launch."

msgid "The temporary per-user WebView2 setting could not be removed. Close WhatsApp and report the error."
msgstr "The temporary per-user WebView2 setting could not be removed. Close WhatsApp and report the error."

msgid "The previous per-user WebView2 setting could not be written back. Close WhatsApp and report the error."
msgstr "The previous per-user WebView2 setting could not be written back. Close WhatsApp and report the error."

msgid "The per-user WebView2 setting changed outside the Companion while it was active. The Companion did not overwrite it. Review the per-user WebView2 policy setting manually."
msgstr "The per-user WebView2 setting changed outside the Companion while it was active. The Companion did not overwrite it. Review the per-user WebView2 policy setting manually."

msgid "The restored per-user WebView2 setting could not be verified. Close WhatsApp and review the per-user WebView2 policy setting manually."
msgstr "The restored per-user WebView2 setting could not be verified. Close WhatsApp and review the per-user WebView2 policy setting manually."

msgid "A saved WebView2 restoration record could not be verified for this Windows account. The Companion did not change it. Contact your administrator or restore the per-user WebView2 policy setting manually."
msgstr "A saved WebView2 restoration record could not be verified for this Windows account. The Companion did not change it. Contact your administrator or restore the per-user WebView2 policy setting manually."

msgid "The required WebView2 policy permissions are already available. No changes were made."
msgstr "The required WebView2 policy permissions are already available. No changes were made."

msgid "Close WhatsApp before diagnosing WebView2 policy permissions."
msgstr "Close WhatsApp before diagnosing WebView2 policy permissions."

msgid "Diagnose and repair requires a normal, non-administrator NVDA session with Windows unlocked."
msgstr "Diagnose and repair requires a normal, non-administrator NVDA session with Windows unlocked."

msgid "The WebView2 policy permissions could not be diagnosed. Close WhatsApp and try again. If this continues, contact your administrator."
msgstr "The WebView2 policy permissions could not be diagnosed. Close WhatsApp and try again. If this continues, contact your administrator."

msgid "A permission repair is available. Review the confirmation dialog to continue or keep the current permissions."
msgstr "A permission repair is available. Review the confirmation dialog to continue or keep the current permissions."

#. Translators: Status when the user cancels the Windows permission request.
msgid "No permission change was made."
msgstr "No permission change was made."

#. Translators: Status when the packaged repair helper is absent.
msgid "The repair helper is missing. Reinstall the add-on."
msgstr "The repair helper is missing. Reinstall the add-on."

msgid "The repair helper could not be verified. Reinstall the add-on from a trusted source."
msgstr "The repair helper could not be verified. Reinstall the add-on from a trusted source."

msgid "Windows blocked the permission repair. Contact your administrator."
msgstr "Windows blocked the permission repair. Contact your administrator."

msgid "The permission repair did not finish. Run the diagnosis again before trying again."
msgstr "The permission repair did not finish. Run the diagnosis again before trying again."

msgid "No compatible repair helper is available for this computer."
msgstr "No compatible repair helper is available for this computer."

msgid "The permission repair could not verify this NVDA session. No change was made."
msgstr "The permission repair could not verify this NVDA session. No change was made."

msgid "Your Windows user profile is not available. Stay logged in and try again."
msgstr "Your Windows user profile is not available. Stay logged in and try again."

msgid "An administrator deny rule still blocks the WebView2 policy key. The repair did not remove or weaken that rule. Contact your administrator."
msgstr "An administrator deny rule still blocks the WebView2 policy key. The repair did not remove or weaken that rule. Contact your administrator."

msgid "The permission repair could not change the Registry permissions. Contact your administrator."
msgstr "The permission repair could not change the Registry permissions. Contact your administrator."

msgid "The permission repair could not be applied. No Registry values were changed."
msgstr "The permission repair could not be applied. No Registry values were changed."

msgid "The permission repair could not be verified and the original permissions were restored. Contact your administrator."
msgstr "The permission repair could not be verified and the original permissions were restored. Contact your administrator."

msgid "The permission repair could not restore the original Registry permissions after an error. Do not launch WhatsApp through the Companion until an administrator reviews the per-user WebView2 policy key."
msgstr "The permission repair could not restore the original Registry permissions after an error. Do not launch WhatsApp through the Companion until an administrator reviews the per-user WebView2 policy key."

msgid "WebView2 policy permissions were repaired for your Windows account. No Registry values were changed. Try launching WhatsApp through the Companion again."
msgstr "WebView2 policy permissions were repaired for your Windows account. No Registry values were changed. Try launching WhatsApp through the Companion again."

msgid "The permission repair reported success but access is still blocked. Do not launch WhatsApp through the Companion. Contact your administrator."
msgstr "The permission repair reported success but access is still blocked. Do not launch WhatsApp through the Companion. Contact your administrator."

msgid "A saved WebView2 setting was restored after the repair. You can launch WhatsApp through the Companion again."
msgstr "A saved WebView2 setting was restored after the repair. You can launch WhatsApp through the Companion again."

msgid "A saved WebView2 setting changed outside the Companion. The Companion did not overwrite it. Review the per-user WebView2 policy setting manually."
msgstr "A saved WebView2 setting changed outside the Companion. The Companion did not overwrite it. Review the per-user WebView2 policy setting manually."

msgid "The temporary WebView2 setting could not be restored. Restart NVDA before trying again."
msgstr "The temporary WebView2 setting could not be restored. Restart NVDA before trying again."

msgid "WhatsApp opened, but the companion could not connect. Close WhatsApp and try again."
msgstr "WhatsApp opened, but the companion could not connect. Close WhatsApp and try again."

msgid "The bundled WhatsApp Web Plus userscript did not start. Close WhatsApp and try again."
msgstr "The bundled WhatsApp Web Plus userscript did not start. Close WhatsApp and try again."

msgid "The downloaded WhatsApp Web Plus userscript did not start and was disabled. Close WhatsApp, then launch it again through the Companion to use the packaged fallback."
msgstr "The downloaded WhatsApp Web Plus userscript did not start and was disabled. Close WhatsApp, then launch it again through the Companion to use the packaged fallback."

#, python-brace-format
msgid "WhatsApp Web Plus userscript was updated from version {currentVersion} to {latestVersion}. The new version will be used the next time WhatsApp is launched through the Companion."
msgstr "WhatsApp Web Plus userscript was updated from version {currentVersion} to {latestVersion}. The new version will be used the next time WhatsApp is launched through the Companion."

#, python-brace-format
msgid "WhatsApp Web Plus userscript was refreshed at version {currentVersion} because the official script differed from the Companion bundle. The refreshed version will be used the next time WhatsApp is launched through the Companion."
msgstr "WhatsApp Web Plus userscript was refreshed at version {currentVersion} because the official script differed from the Companion bundle. The refreshed version will be used the next time WhatsApp is launched through the Companion."

#, python-brace-format
msgid "The WhatsApp Web Plus userscript is up to date at version {currentVersion}."
msgstr "The WhatsApp Web Plus userscript is up to date at version {currentVersion}."

msgid "The WhatsApp Web Plus userscript update could not be downloaded. Check your internet connection and try again. The existing Companion bundle was not changed."
msgstr "The WhatsApp Web Plus userscript update could not be downloaded. Check your internet connection and try again. The existing Companion bundle was not changed."

msgid "The downloaded WhatsApp Web Plus userscript update could not be verified. The existing Companion bundle was not changed."
msgstr "The downloaded WhatsApp Web Plus userscript update could not be verified. The existing Companion bundle was not changed."

msgid "The signed WhatsApp Web Plus userscript update uses a key this version does not trust. Update WhatsApp Companion and try again. The existing Companion bundle was not changed."
msgstr "The signed WhatsApp Web Plus userscript update uses a key this version does not trust. Update WhatsApp Companion and try again. The existing Companion bundle was not changed."

msgid "The verified WhatsApp Web Plus userscript update could not be installed. The existing Companion bundle was not changed."
msgstr "The verified WhatsApp Web Plus userscript update could not be installed. The existing Companion bundle was not changed."

msgid "The WhatsApp Web Plus userscript could not be updated. The existing Companion bundle was not changed."
msgstr "The WhatsApp Web Plus userscript could not be updated. The existing Companion bundle was not changed."

msgid "The userscript bundle cannot be updated in this NVDA context. Use a normal NVDA session."
msgstr "The userscript bundle cannot be updated in this NVDA context. Use a normal NVDA session."

#. Translators: Fallback launch failure with a safe recovery action.
msgid "WhatsApp Companion could not start. Close WhatsApp and try again."
msgstr "WhatsApp Companion could not start. Close WhatsApp and try again."

#. Translators: Appended only when the user explicitly reports a detailed update failure.
#, python-brace-format
msgid "Technical error code: {errorCode}."
msgstr "Technical error code: {errorCode}."

#. Translators: Microsoft Store WhatsApp release channel name.
msgid "Beta"
msgstr "Beta"

#. Translators: Microsoft Store WhatsApp release channel name.
msgid "Stable"
msgstr "Stable"

#. Translators: Combined Microsoft Store WhatsApp release channels in a force-close result.
msgid "Stable and Beta"
msgstr "Stable and Beta"

#. Translators: Immediate progress after the user starts the permission diagnosis.
msgid "Checking WebView2 policy permissions."
msgstr "Checking WebView2 policy permissions."

msgid "WhatsApp is currently running. The Companion must force close all Microsoft Store WhatsApp Stable and Beta processes before it can diagnose WebView2 policy permissions. Active calls and file transfers will be interrupted, and text you have not sent may be lost. Do you want to force close WhatsApp and continue the diagnosis? If a repair is needed, you will review a separate confirmation before Windows asks for administrator approval."
msgstr "WhatsApp is currently running. The Companion must force close all Microsoft Store WhatsApp Stable and Beta processes before it can diagnose WebView2 policy permissions. Active calls and file transfers will be interrupted, and text you have not sent may be lost. Do you want to force close WhatsApp and continue the diagnosis? If a repair is needed, you will review a separate confirmation before Windows asks for administrator approval."

#. Translators: Title of the confirmation shown when permission diagnosis requires closing WhatsApp.
msgid "Close WhatsApp to continue diagnosis?"
msgstr "Close WhatsApp to continue diagnosis?"

#. Translators: Safe default button that cancels permission diagnosis without closing WhatsApp.
#. Translators: Safe default button that cancels force closing WhatsApp.
msgid "&Keep WhatsApp open"
msgstr "&Keep WhatsApp open"

#. Translators: Destructive button that closes WhatsApp and resumes permission diagnosis.
msgid "&Force close WhatsApp and continue"
msgstr "&Force close WhatsApp and continue"

msgid "Force closing Microsoft Store WhatsApp Stable and Beta processes before continuing diagnosis."
msgstr "Force closing Microsoft Store WhatsApp Stable and Beta processes before continuing diagnosis."

msgid "WhatsApp Companion needs a temporary WebView2 launch setting before starting WhatsApp. Windows is blocking the per-user Registry key that stores this setting. This repair gives your Windows account permission to read, create, change, and delete values inside that one WebView2 policy key. Windows protects the whole key rather than individual values, so other programs running as your account could also change values in that key. The repair will not change any Registry value, any machine-wide policy, any administrator deny rule, your WhatsApp data, or your chat content. Only a small repair helper runs as administrator, while NVDA and WhatsApp stay unelevated. The permission stays in place after you restart Windows or remove the add-on. Do you want to continue to the Windows permission request?"
msgstr "WhatsApp Companion needs a temporary WebView2 launch setting before starting WhatsApp. Windows is blocking the per-user Registry key that stores this setting. This repair gives your Windows account permission to read, create, change, and delete values inside that one WebView2 policy key. Windows protects the whole key rather than individual values, so other programs running as your account could also change values in that key. The repair will not change any Registry value, any machine-wide policy, any administrator deny rule, your WhatsApp data, or your chat content. Only a small repair helper runs as administrator, while NVDA and WhatsApp stay unelevated. The permission stays in place after you restart Windows or remove the add-on. Do you want to continue to the Windows permission request?"

#. Translators: Title of the WebView2 policy permission repair confirmation dialog.
msgid "Repair per-user WebView2 policy permissions?"
msgstr "Repair per-user WebView2 policy permissions?"

#. Translators: Safe default button that cancels the permission repair.
msgid "&Keep current permissions"
msgstr "&Keep current permissions"

#. Translators: Affirmative button that continues to the Windows permission request.
msgid "&Continue to User Account Control"
msgstr "&Continue to User Account Control"

msgid "Opening the Windows permission request. NVDA will keep running without administrator privileges."
msgstr "Opening the Windows permission request. NVDA will keep running without administrator privileges."

#. Translators: Warning shown before force closing all supported Microsoft Store WhatsApp processes.
msgid "This will immediately close every running Microsoft Store WhatsApp app, including Stable and Beta. Active calls and file transfers will be interrupted. Text you have not sent may be lost. Do you want to continue?"
msgstr "This will immediately close every running Microsoft Store WhatsApp app, including Stable and Beta. Active calls and file transfers will be interrupted. Text you have not sent may be lost. Do you want to continue?"

#. Translators: Title of the Microsoft Store WhatsApp force-close confirmation dialog.
msgid "Force close WhatsApp applications?"
msgstr "Force close WhatsApp applications?"

#. Translators: Destructive confirmation button that closes all supported WhatsApp processes.
msgid "&Force close"
msgstr "&Force close"

#. Translators: Immediate progress after the user confirms force closing both WhatsApp channels.
msgid "Closing all running WhatsApp Stable and Beta apps from Microsoft Store."
msgstr "Closing all running WhatsApp Stable and Beta apps from Microsoft Store."

msgid "A WhatsApp Web Plus userscript update check is already in progress."
msgstr "A WhatsApp Web Plus userscript update check is already in progress."

msgid "Checking for a signed WhatsApp Web Plus userscript update."
msgstr "Checking for a signed WhatsApp Web Plus userscript update."

#. Translators: Spoken and brailled when no companion operation has completed yet.
msgid "No WhatsApp Companion result is available yet."
msgstr "No WhatsApp Companion result is available yet."

#. Translators: Title for a dialog that shows the most recent companion or update result.
msgid "WhatsApp Companion last result"
msgstr "WhatsApp Companion last result"

msgid "Check for and install WhatsApp Web Plus userscript updates"
msgstr "Check for and install WhatsApp Web Plus userscript updates"

#. Translators: Command description in NVDA's Input Gestures dialog.
msgid "Diagnose and repair WebView2 policy permissions"
msgstr "Diagnose and repair WebView2 policy permissions"

msgid "WhatsApp Companion makes Microsoft Store WhatsApp Stable and Beta easier to use with NVDA. It brings WhatsApp Web Plus features to the desktop app, with keyboard navigation, message reading, and call controls with customizable labels."
msgstr "WhatsApp Companion makes Microsoft Store WhatsApp Stable and Beta easier to use with NVDA. It brings WhatsApp Web Plus features to the desktop app, with keyboard navigation, message reading, and call controls with customizable labels."

msgid "You can now control calls with keyboard shortcuts, add call labels in multiple languages, and read messages in NVDA. Startup recovery and spoken feedback are also improved. This release includes WhatsApp Web Plus 2.6.83 and requires NVDA 2025.1 or later."
msgstr "You can now control calls with keyboard shortcuts, add call labels in multiple languages, and read messages in NVDA. Startup recovery and spoken feedback are also improved. This release includes WhatsApp Web Plus 2.6.83 and requires NVDA 2025.1 or later."

#~ msgid "Launching WhatsApp {channel} with WhatsApp Companion."
#~ msgstr "Launching WhatsApp {channel} with WhatsApp Companion."

#~ msgid "Checking for WhatsApp Web Plus userscript updates. If the official userscript has a newer version or different content, the Companion will download and install it automatically."
#~ msgstr "Checking for WhatsApp Web Plus userscript updates. If the official userscript has a newer version or different content, the Companion will download and install it automatically."

msgid "Toggle native WhatsApp call camera"
msgstr "Toggle native WhatsApp call camera"

msgid "Toggle native WhatsApp call mute"
msgstr "Toggle native WhatsApp call mute"

msgid "Open native WhatsApp call reactions"
msgstr "Open native WhatsApp call reactions"

msgid "Raise or lower hand in native WhatsApp call"
msgstr "Raise or lower hand in native WhatsApp call"

msgid "Start or stop screen sharing in native WhatsApp call"
msgstr "Start or stop screen sharing in native WhatsApp call"

msgid "End native WhatsApp call"
msgstr "End native WhatsApp call"

msgid "Requested the full call view. Release the keys, check the window, then press the shortcut again."
msgstr "Requested the full call view. Release the keys, check the window, then press the shortcut again."

msgid "Could not confirm call view recovery. Open the full call window manually."
msgstr "Could not confirm call view recovery. Open the full call window manually."

msgid "Could not verify whether WhatsApp is running. Permission diagnosis stopped. Try again after checking WhatsApp."
msgstr "Could not verify whether WhatsApp is running. Permission diagnosis stopped. Try again after checking WhatsApp."

msgid "Call control lab&els..."
msgstr "Call control lab&els..."

msgid "Customize call control labels for the language used by WhatsApp"
msgstr "Customize call control labels for the language used by WhatsApp"

msgid "Call control labels saved."
msgstr "Call control labels saved."

msgid "Could not load call control labels. Your saved settings were not changed."
msgstr "Could not load call control labels. Your saved settings were not changed."

msgid "Answer incoming call"
msgstr "Answer incoming call"

msgid "Decline incoming call"
msgstr "Decline incoming call"

msgid "Camera on/off"
msgstr "Camera on/off"

msgid "Microphone mute/unmute (including compact view)"
