#. Translators: Category name shown in NVDA's Input Gestures dialog.
msgid "WhatsApp Companion"
msgstr "WhatsApp Companion"

msgid "Answer WhatsApp call"
msgstr "Jawab panggilan WhatsApp"

msgid "Decline WhatsApp call"
msgstr "Tolak panggilan WhatsApp"

msgid "Couldn't confirm that it worked. Check the WhatsApp call window."
msgstr "Belum dapat dipastikan berhasil. Periksa jendela panggilan WhatsApp."

msgid "Save WhatsApp call diagnostics to the NVDA log"
msgstr "Simpan diagnostik panggilan WhatsApp ke log NVDA"

msgid "Call diagnostics are unavailable in this NVDA session."
msgstr "Diagnostik panggilan tidak tersedia dalam sesi NVDA ini."

msgid "Go to the WhatsApp call window first."
msgstr "Buka jendela panggilan WhatsApp terlebih dahulu."

msgid "Couldn't save call diagnostics."
msgstr "Tidak dapat menyimpan diagnostik panggilan."

msgid "Call diagnostics saved to the NVDA log. No call buttons were pressed."
msgstr "Diagnostik panggilan disimpan ke log NVDA. Tidak ada tombol panggilan yang ditekan."

#, python-brace-format
msgid "{count} braille announcements skipped."
msgstr "{count} pengumuman braille dilewati."

msgid "WhatsApp Web Plus announcement cleared."
msgstr "Pengumuman WhatsApp Web Plus telah dibersihkan."

#. Translators: Submenu label shown under NVDA's Tools menu.
msgid "&WhatsApp Companion"
msgstr "&WhatsApp Companion"

msgid "Open WhatsApp with WhatsApp Companion and manage its settings."
msgstr "Buka WhatsApp dengan WhatsApp Companion dan atur pengaturannya."

#. Translators: Tools submenu command. The ampersand marks the mnemonic.
msgid "Launch WhatsApp &Stable with WhatsApp Companion"
msgstr "Luncurkan WhatsApp &Stable dengan WhatsApp Companion"

#. Translators: Command description in NVDA's Input Gestures dialog.
msgid "Launch WhatsApp Stable with WhatsApp Companion"
msgstr "Luncurkan WhatsApp Stable dengan WhatsApp Companion"

#. Translators: Tools submenu command. The ampersand marks the mnemonic.
msgid "Launch WhatsApp &Beta with WhatsApp Companion"
msgstr "Luncurkan WhatsApp &Beta dengan WhatsApp Companion"

#. Translators: Command description in NVDA's Input Gestures dialog.
msgid "Launch WhatsApp Beta with WhatsApp Companion"
msgstr "Luncurkan WhatsApp Beta dengan WhatsApp Companion"

#. Translators: Tools submenu command. The ampersand marks the mnemonic.
msgid "Launch the &last selected WhatsApp channel with WhatsApp Companion"
msgstr "Luncurkan &kanal WhatsApp terakhir yang dipilih dengan WhatsApp Companion"

msgid "Launch the last selected WhatsApp channel with WhatsApp Companion"
msgstr "Luncurkan kanal WhatsApp terakhir yang dipilih dengan WhatsApp Companion"

#. Translators: Tools submenu command. The ellipsis is required because activation may show a confirmation dialog.
msgid "Diagnose and repair WebView2 &policy permissions..."
msgstr "Diagnosa dan perbaiki &izin kebijakan WebView2..."

msgid "Check the WebView2 permissions WhatsApp Companion needs, and fix them if needed"
msgstr "Periksa izin WebView2 yang dibutuhkan WhatsApp Companion, dan perbaiki jika perlu"

#. Translators: Tools submenu command. The ampersand marks the mnemonic.
msgid "&Report the last WhatsApp Companion result"
msgstr "&Laporkan hasil WhatsApp Companion terakhir"

#. Translators: Command description in NVDA's Input Gestures dialog.
msgid "Report the last WhatsApp Companion result"
msgstr "Laporkan hasil WhatsApp Companion terakhir"

#. Translators: Tools submenu command. The ampersand marks the mnemonic.
msgid "&Check for WhatsApp Web Plus userscript updates"
msgstr "&Periksa pembaruan userscript WhatsApp Web Plus"

msgid "Check for and install the latest official WhatsApp Web Plus"
msgstr "Periksa dan pasang WhatsApp Web Plus resmi terbaru"

msgid "Some announcements were missed while reconnecting."
msgstr "Beberapa pengumuman terlewat saat menyambung kembali."

msgid "The previous launch is still finishing. Wait a moment and try again. If this keeps happening, restart NVDA."
msgstr "Peluncuran sebelumnya belum selesai. Tunggu sebentar, lalu coba lagi. Jika terus terjadi, mulai ulang NVDA."

#. Translators: Spoken and brailled after the companion has loaded successfully.
#, python-brace-format
msgid "WhatsApp {channel} is ready with WhatsApp Companion."
msgstr "WhatsApp {channel} siap dengan WhatsApp Companion."

#, python-brace-format
msgid "Opening WhatsApp {channel} with WhatsApp Companion. Please wait."
msgstr "Membuka WhatsApp {channel} dengan WhatsApp Companion. Mohon tunggu."

#. Translators: Spoken and brailled when a launch command is invoked while a session is active.
msgid "WhatsApp Companion is already running. Close WhatsApp first."
msgstr "WhatsApp Companion sudah berjalan. Tutup WhatsApp terlebih dahulu."

#. Translators: Spoken and brailled when the user closes WhatsApp normally.
#, python-brace-format
msgid "WhatsApp {channel} was closed. WhatsApp Companion stopped."
msgstr "WhatsApp {channel} telah ditutup. WhatsApp Companion berhenti."

#. Translators: Recovery message when WhatsApp was already open before the companion started.
msgid "WhatsApp is already open. Close it, then try again."
msgstr "WhatsApp sudah terbuka. Tutup dulu, lalu coba lagi."

#. Translators: Spoken and brailled when NVDA stops an in-progress launch.
msgid "Launch cancelled."
msgstr "Peluncuran dibatalkan."

#. Translators: Status when another force-close request is made while one is running.
msgid "WhatsApp is already being closed. Please wait."
msgstr "WhatsApp sedang ditutup. Mohon tunggu."

msgid "WhatsApp Stable and Beta weren't running."
msgstr "WhatsApp Stable dan Beta tidak sedang berjalan."

#, python-brace-format
msgid "WhatsApp Stable and Beta were closed ({closedCount} processes)."
msgstr "WhatsApp Stable dan Beta sudah ditutup ({closedCount} proses)."

#, python-brace-format
msgid "Closed {closedCount} WhatsApp processes, but WhatsApp {remainingChannels} may still be running. Restart Windows before launching again."
msgstr "{closedCount} proses WhatsApp sudah ditutup, tetapi WhatsApp {remainingChannels} mungkin masih berjalan. Mulai ulang Windows sebelum meluncurkan lagi."

#, python-brace-format
msgid "Couldn't close WhatsApp {remainingChannels}, or couldn't confirm that it closed. Restart Windows before launching again."
msgstr "Tidak dapat menutup WhatsApp {remainingChannels}, atau tidak dapat memastikan sudah tertutup. Mulai ulang Windows sebelum meluncurkan lagi."

msgid "Can't close WhatsApp from this NVDA session. Unlock Windows and run NVDA normally, not as administrator."
msgstr "Tidak dapat menutup WhatsApp dari sesi NVDA ini. Buka kunci Windows dan jalankan NVDA seperti biasa, bukan sebagai administrator."

#. Translators: Recovery message for locked, secure, read-only, or elevated NVDA contexts.
msgid "Unlock Windows and run NVDA normally, not as administrator, then try again."
msgstr "Buka kunci Windows dan jalankan NVDA seperti biasa, bukan sebagai administrator, lalu coba lagi."

#. Translators: Recovery message when the selected Microsoft Store WhatsApp channel is unavailable.
msgid "Install this WhatsApp from Microsoft Store, then try again."
msgstr "Pasang WhatsApp ini dari Microsoft Store, lalu coba lagi."

msgid "Couldn't safely use the Windows Registry. Restart NVDA and try again. If this keeps happening, report it."
msgstr "Tidak dapat memakai Windows Registry dengan aman. Mulai ulang NVDA, lalu coba lagi. Jika terus terjadi, laporkan masalah ini."

msgid "Another WhatsApp Companion task may still be using the Registry. Restart NVDA and try again. If this keeps happening, report it."
msgstr "Tugas WhatsApp Companion lain mungkin masih memakai Registry. Mulai ulang NVDA, lalu coba lagi. Jika terus terjadi, laporkan masalah ini."

msgid "Windows blocked the computer-wide WebView2 setting. Ask your administrator for help."
msgstr "Windows memblokir pengaturan WebView2 untuk seluruh komputer. Minta bantuan administrator."

msgid "Couldn't check the computer-wide WebView2 setting. Ask your administrator, or report it."
msgstr "Tidak dapat memeriksa pengaturan WebView2 untuk seluruh komputer. Minta bantuan administrator, atau laporkan masalah ini."

msgid "A Windows policy controls WebView2 for this WhatsApp, and WhatsApp Companion can't override it. Nothing was changed. Ask your administrator for help."
msgstr "Kebijakan Windows mengatur WebView2 untuk WhatsApp ini, dan WhatsApp Companion tidak dapat menimpanya. Tidak ada yang diubah. Minta bantuan administrator."

msgid "A Windows policy controls WebView2 for all apps, and WhatsApp Companion can't override it. Nothing was changed. Ask your administrator for help."
msgstr "Kebijakan Windows mengatur WebView2 untuk semua aplikasi, dan WhatsApp Companion tidak dapat menimpanya. Tidak ada yang diubah. Minta bantuan administrator."

msgid "Windows blocked a WebView2 setting that WhatsApp Companion needs. In the WhatsApp Companion menu, choose Diagnose and repair WebView2 policy permissions, then try again."
msgstr "Windows memblokir pengaturan WebView2 yang dibutuhkan WhatsApp Companion. Di menu WhatsApp Companion, pilih Diagnosa dan perbaiki izin kebijakan WebView2, lalu coba lagi."

msgid "Couldn't read your WebView2 setting. Close WhatsApp and try again. If this keeps happening, report it."
msgstr "Tidak dapat membaca pengaturan WebView2 Anda. Tutup WhatsApp, lalu coba lagi. Jika terus terjadi, laporkan masalah ini."

msgid "Your WebView2 launch setting uses a type WhatsApp Companion doesn't support, so it was left unchanged. Check it manually."
msgstr "Pengaturan peluncuran WebView2 Anda memakai tipe yang tidak didukung WhatsApp Companion, jadi tidak diubah. Periksa secara manual."

msgid "This WhatsApp already has a remote debugging setting that WhatsApp Companion didn't create, so it was left unchanged. Remove it yourself if you don't need it."
msgstr "WhatsApp ini sudah punya pengaturan remote debugging yang tidak dibuat oleh WhatsApp Companion, jadi tidak diubah. Hapus sendiri jika tidak diperlukan."

msgid "Windows didn't let WhatsApp Companion save its temporary WebView2 setting, so WhatsApp wasn't launched. In the WhatsApp Companion menu, choose Diagnose and repair WebView2 policy permissions, then try again."
msgstr "Windows tidak mengizinkan WhatsApp Companion menyimpan pengaturan WebView2 sementara, jadi WhatsApp tidak diluncurkan. Di menu WhatsApp Companion, pilih Diagnosa dan perbaiki izin kebijakan WebView2, lalu coba lagi."

msgid "Couldn't save the temporary WebView2 setting, so WhatsApp wasn't launched. Close WhatsApp and try again. If this keeps happening, report it."
msgstr "Tidak dapat menyimpan pengaturan WebView2 sementara, jadi WhatsApp tidak diluncurkan. Tutup WhatsApp, lalu coba lagi. Jika terus terjadi, laporkan masalah ini."

msgid "Couldn't write the temporary WebView2 setting, so WhatsApp wasn't launched. Close WhatsApp and try again. If this keeps happening, report it."
msgstr "Tidak dapat menulis pengaturan WebView2 sementara, jadi WhatsApp tidak diluncurkan. Tutup WhatsApp, lalu coba lagi. Jika terus terjadi, laporkan masalah ini."

msgid "Couldn't confirm the temporary WebView2 setting. Close WhatsApp and try again."
msgstr "Tidak dapat memastikan pengaturan WebView2 sementara. Tutup WhatsApp, lalu coba lagi."

msgid "Couldn't put your previous WebView2 setting back. Close WhatsApp now, then run Diagnose and repair WebView2 policy permissions. WhatsApp Companion will try again before the next launch."
msgstr "Tidak dapat mengembalikan pengaturan WebView2 Anda sebelumnya. Tutup WhatsApp sekarang, lalu jalankan Diagnosa dan perbaiki izin kebijakan WebView2. WhatsApp Companion akan mencoba lagi sebelum peluncuran berikutnya."

msgid "Couldn't open your previous WebView2 setting to put it back. Close WhatsApp and report it."
msgstr "Tidak dapat membuka pengaturan WebView2 Anda sebelumnya untuk mengembalikannya. Tutup WhatsApp dan laporkan masalah ini."

msgid "Couldn't remove the temporary WebView2 setting. Close WhatsApp now, then run Diagnose and repair WebView2 policy permissions. WhatsApp Companion will try again before the next launch."
msgstr "Tidak dapat menghapus pengaturan WebView2 sementara. Tutup WhatsApp sekarang, lalu jalankan Diagnosa dan perbaiki izin kebijakan WebView2. WhatsApp Companion akan mencoba lagi sebelum peluncuran berikutnya."

msgid "The temporary WebView2 setting couldn't be removed. Close WhatsApp and report it."
msgstr "Pengaturan WebView2 sementara tidak dapat dihapus. Tutup WhatsApp dan laporkan masalah ini."

msgid "Your previous WebView2 setting couldn't be written back. Close WhatsApp and report it."
msgstr "Pengaturan WebView2 Anda sebelumnya tidak dapat ditulis kembali. Tutup WhatsApp dan laporkan masalah ini."

msgid "Another program changed your WebView2 setting during launch, so it was left as is. Check it manually."
msgstr "Program lain mengubah pengaturan WebView2 Anda saat peluncuran, jadi dibiarkan apa adanya. Periksa secara manual."

msgid "Couldn't confirm that your WebView2 setting was put back. Close WhatsApp and check it manually."
msgstr "Tidak dapat memastikan pengaturan WebView2 Anda sudah dikembalikan. Tutup WhatsApp dan periksa secara manual."

msgid "A saved WebView2 restore record doesn't match this Windows account, so nothing was changed. Ask your administrator, or restore the setting manually."
msgstr "Catatan pemulihan WebView2 yang tersimpan tidak cocok dengan akun Windows ini, jadi tidak ada yang diubah. Minta bantuan administrator, atau pulihkan pengaturannya secara manual."

msgid "WebView2 permissions are fine. Nothing needs fixing."
msgstr "Izin WebView2 sudah benar. Tidak ada yang perlu diperbaiki."

msgid "Close WhatsApp before checking WebView2 permissions."
msgstr "Tutup WhatsApp sebelum memeriksa izin WebView2."

msgid "To check permissions, unlock Windows and run NVDA normally, not as administrator."
msgstr "Untuk memeriksa izin, buka kunci Windows dan jalankan NVDA seperti biasa, bukan sebagai administrator."

msgid "Couldn't check WebView2 permissions. Close WhatsApp and try again. If this keeps happening, ask your administrator."
msgstr "Tidak dapat memeriksa izin WebView2. Tutup WhatsApp, lalu coba lagi. Jika terus terjadi, minta bantuan administrator."

msgid "A repair is available. Choose in the dialog whether to continue."
msgstr "Perbaikan tersedia. Pilih di dialog apakah ingin melanjutkan."

#. Translators: Status when the user cancels the Windows permission request.
msgid "Permissions were not changed."
msgstr "Izin tidak diubah."

#. Translators: Status when the packaged repair helper is absent.
msgid "The repair helper is missing. Reinstall the add-on."
msgstr "Helper perbaikan tidak ditemukan. Pasang ulang add-on."

msgid "The repair helper failed its safety check. Reinstall the add-on from a trusted source."
msgstr "Helper perbaikan gagal dalam pemeriksaan keamanan. Pasang ulang add-on dari sumber tepercaya."

msgid "Windows blocked the repair. Ask your administrator for help."
msgstr "Windows memblokir perbaikan. Minta bantuan administrator."

msgid "The repair didn't finish. Run the check again."
msgstr "Perbaikan tidak selesai. Jalankan pemeriksaan lagi."

msgid "There's no repair helper for this computer."
msgstr "Tidak ada helper perbaikan untuk komputer ini."

msgid "The repair couldn't confirm this NVDA session, so nothing was changed."
msgstr "Perbaikan tidak dapat memastikan sesi NVDA ini, jadi tidak ada yang diubah."

msgid "Your Windows profile isn't available. Stay signed in and try again."
msgstr "Profil Windows Anda tidak tersedia. Tetap masuk, lalu coba lagi."

msgid "An administrator rule still blocks the WebView2 setting. The repair never removes such rules. Ask your administrator for help."
msgstr "Aturan administrator masih memblokir pengaturan WebView2. Perbaikan tidak pernah menghapus aturan seperti itu. Minta bantuan administrator."

msgid "The repair couldn't change the Registry permissions. Ask your administrator for help."
msgstr "Perbaikan tidak dapat mengubah izin Registry. Minta bantuan administrator."

msgid "The repair couldn't be applied. Nothing was changed."
msgstr "Perbaikan tidak dapat diterapkan. Tidak ada yang diubah."

msgid "The repair couldn't be confirmed, so the original permissions were put back. Ask your administrator for help."
msgstr "Perbaikan tidak dapat dipastikan, jadi izin semula dikembalikan. Minta bantuan administrator."

msgid "After an error, the repair couldn't put the original permissions back. Don't launch WhatsApp with WhatsApp Companion until an administrator checks the WebView2 setting."
msgstr "Setelah terjadi kesalahan, perbaikan tidak dapat mengembalikan izin semula. Jangan luncurkan WhatsApp dengan WhatsApp Companion sampai administrator memeriksa pengaturan WebView2."

msgid "WebView2 permissions are fixed. You can launch WhatsApp with WhatsApp Companion now."
msgstr "Izin WebView2 sudah diperbaiki. Sekarang Anda bisa meluncurkan WhatsApp dengan WhatsApp Companion."

msgid "The repair finished, but access is still blocked. Don't launch WhatsApp with WhatsApp Companion yet. Ask your administrator for help."
msgstr "Perbaikan selesai, tetapi akses masih diblokir. Jangan luncurkan WhatsApp dengan WhatsApp Companion dulu. Minta bantuan administrator."

msgid "A saved WebView2 setting was put back. You can launch WhatsApp with WhatsApp Companion again."
msgstr "Pengaturan WebView2 yang tersimpan sudah dikembalikan. Anda bisa meluncurkan WhatsApp dengan WhatsApp Companion lagi."

msgid "Another program changed a saved WebView2 setting, so it was left as is. Check it manually."
msgstr "Program lain mengubah pengaturan WebView2 yang tersimpan, jadi dibiarkan apa adanya. Periksa secara manual."

msgid "Couldn't undo the temporary WebView2 setting. Restart NVDA, then try again."
msgstr "Tidak dapat membatalkan pengaturan WebView2 sementara. Mulai ulang NVDA, lalu coba lagi."

msgid "WhatsApp opened, but WhatsApp Companion couldn't connect. Close WhatsApp and try again."
msgstr "WhatsApp terbuka, tetapi WhatsApp Companion tidak dapat tersambung. Tutup WhatsApp, lalu coba lagi."

msgid "WhatsApp Web Plus didn't start. Close WhatsApp and try again."
msgstr "WhatsApp Web Plus tidak berjalan. Tutup WhatsApp, lalu coba lagi."

msgid "The downloaded WhatsApp Web Plus update didn't start, so it was turned off. Close WhatsApp and launch it again to use the built-in version."
msgstr "Pembaruan WhatsApp Web Plus yang diunduh tidak berjalan, jadi dinonaktifkan. Tutup WhatsApp, lalu luncurkan lagi untuk memakai versi bawaan."

#, python-brace-format
msgid "WhatsApp Web Plus was updated from {currentVersion} to {latestVersion}. It will be used the next time you launch WhatsApp."
msgstr "WhatsApp Web Plus diperbarui dari {currentVersion} ke {latestVersion}. Versi baru dipakai saat WhatsApp diluncurkan berikutnya."

#, python-brace-format
msgid "WhatsApp Web Plus {currentVersion} was replaced with the official copy. It will be used the next time you launch WhatsApp."
msgstr "WhatsApp Web Plus {currentVersion} diganti dengan salinan resmi. Salinan ini dipakai saat WhatsApp diluncurkan berikutnya."

#, python-brace-format
msgid "WhatsApp Web Plus is up to date ({currentVersion})."
msgstr "WhatsApp Web Plus sudah versi terbaru ({currentVersion})."

msgid "Couldn't download the WhatsApp Web Plus update. Check your internet connection and try again. Your current version was kept."
msgstr "Tidak dapat mengunduh pembaruan WhatsApp Web Plus. Periksa koneksi internet, lalu coba lagi. Versi yang ada tetap dipakai."

msgid "The WhatsApp Web Plus update failed its safety check. Your current version was kept."
msgstr "Pembaruan WhatsApp Web Plus gagal dalam pemeriksaan keamanan. Versi yang ada tetap dipakai."

msgid "The WhatsApp Web Plus update is signed with a key this version doesn't know. Update WhatsApp Companion, then try again. Your current version was kept."
msgstr "Pembaruan WhatsApp Web Plus ditandatangani dengan kunci yang tidak dikenal versi ini. Perbarui WhatsApp Companion, lalu coba lagi. Versi yang ada tetap dipakai."

msgid "Couldn't install the WhatsApp Web Plus update. Your current version was kept."
msgstr "Tidak dapat memasang pembaruan WhatsApp Web Plus. Versi yang ada tetap dipakai."

msgid "Couldn't update WhatsApp Web Plus. Your current version was kept."
msgstr "Tidak dapat memperbarui WhatsApp Web Plus. Versi yang ada tetap dipakai."

msgid "WhatsApp Web Plus can't be updated from this NVDA session. Use NVDA normally."
msgstr "WhatsApp Web Plus tidak dapat diperbarui dari sesi NVDA ini. Gunakan NVDA seperti biasa."

#. Translators: Fallback launch failure with a safe recovery action.
msgid "WhatsApp Companion could not start. Close WhatsApp and try again."
msgstr "WhatsApp Companion tidak dapat dimulai. Tutup WhatsApp lalu coba lagi."

#. Translators: Appended only when the user explicitly reports a detailed update failure.
#, python-brace-format
msgid "Technical error code: {errorCode}."
msgstr "Kode kesalahan teknis: {errorCode}."

#. Translators: Microsoft Store WhatsApp release channel name.
msgid "Beta"
msgstr "Beta"

#. Translators: Microsoft Store WhatsApp release channel name.
msgid "Stable"
msgstr "Stable"

#. Translators: Combined Microsoft Store WhatsApp release channels in a force-close result.
msgid "Stable and Beta"
msgstr "Stable dan Beta"

#. Translators: Immediate progress after the user starts the permission diagnosis.
msgid "Checking WebView2 permissions."
msgstr "Memeriksa izin WebView2."

msgid "WhatsApp is open. To check WebView2 permissions, WhatsApp Companion must close WhatsApp Stable and Beta first. Calls and file transfers will stop, and unsent text may be lost. If a repair is needed, you'll be asked again before Windows asks for administrator approval. Close WhatsApp and continue?"
msgstr "WhatsApp sedang terbuka. Untuk memeriksa izin WebView2, WhatsApp Companion harus menutup WhatsApp Stable dan Beta terlebih dahulu. Panggilan dan transfer file akan berhenti, dan teks yang belum dikirim bisa hilang. Jika perlu perbaikan, Anda akan ditanya lagi sebelum Windows meminta persetujuan administrator. Tutup WhatsApp dan lanjutkan?"

#. Translators: Title of the confirmation shown when permission diagnosis requires closing WhatsApp.
msgid "Close WhatsApp to continue diagnosis?"
msgstr "Tutup WhatsApp untuk melanjutkan diagnosis?"

#. Translators: Safe default button that cancels permission diagnosis without closing WhatsApp.
#. Translators: Safe default button that cancels force closing WhatsApp.
msgid "&Keep WhatsApp open"
msgstr "&Biarkan WhatsApp tetap terbuka"

#. Translators: Destructive button that closes WhatsApp and resumes permission diagnosis.
msgid "&Force close WhatsApp and continue"
msgstr "&Tutup paksa WhatsApp dan lanjutkan"

msgid "Closing WhatsApp Stable and Beta before the check."
msgstr "Menutup WhatsApp Stable dan Beta sebelum pemeriksaan."

msgid "WhatsApp Companion saves a temporary WebView2 setting each time it launches WhatsApp, but Windows is blocking the place where it is stored. This repair creates that WebView2 policy key if it is missing, and lets your Windows account read and change values in it. Other programs running under your account could then change that key too. The repair doesn't change any setting values, computer-wide policies, administrator rules, WhatsApp data or chats. Only a small helper runs as administrator; NVDA and WhatsApp don't. The permission stays after you restart Windows or remove the add-on. Continue to the Windows permission prompt?"
msgstr "WhatsApp Companion menyimpan pengaturan WebView2 sementara setiap kali meluncurkan WhatsApp, tetapi Windows memblokir tempat penyimpanannya. Perbaikan ini membuat kunci kebijakan WebView2 tersebut jika belum ada, dan mengizinkan akun Windows Anda membaca serta mengubah nilai di dalamnya. Program lain yang berjalan dengan akun Anda juga bisa mengubah kunci itu. Perbaikan ini tidak mengubah nilai pengaturan apa pun, kebijakan untuk seluruh komputer, aturan administrator, data WhatsApp, atau chat. Hanya helper kecil yang berjalan sebagai administrator; NVDA dan WhatsApp tidak. Izin ini tetap ada setelah Windows dimulai ulang atau add-on dihapus. Lanjutkan ke permintaan izin Windows?"

#. Translators: Title of the WebView2 policy permission repair confirmation dialog.
msgid "Repair per-user WebView2 policy permissions?"
msgstr "Perbaiki izin kebijakan WebView2 per pengguna?"

#. Translators: Safe default button that cancels the permission repair.
msgid "&Keep current permissions"
msgstr "&Pertahankan izin saat ini"

#. Translators: Affirmative button that continues to the Windows permission request.
msgid "&Continue to User Account Control"
msgstr "&Lanjut ke User Account Control"

msgid "Opening the Windows permission prompt. NVDA keeps running without administrator rights."
msgstr "Membuka permintaan izin Windows. NVDA tetap berjalan tanpa hak administrator."

#. Translators: Destructive confirmation button that closes all supported WhatsApp processes.
msgid "&Force close"
msgstr "&Tutup paksa"

#. Translators: Immediate progress after the user confirms force closing both WhatsApp channels.
msgid "Closing WhatsApp Stable and Beta."
msgstr "Menutup WhatsApp Stable dan Beta."

msgid "Already checking for WhatsApp Web Plus updates."
msgstr "Pemeriksaan pembaruan WhatsApp Web Plus sedang berjalan."

msgid "Checking for WhatsApp Web Plus updates."
msgstr "Memeriksa pembaruan WhatsApp Web Plus."

#. Translators: Spoken and brailled when no companion operation has completed yet.
msgid "Nothing to report yet."
msgstr "Belum ada yang bisa dilaporkan."

#. Translators: Title for a dialog that shows the most recent companion or update result.
msgid "WhatsApp Companion last result"
msgstr "Hasil terakhir WhatsApp Companion"

msgid "Check for and install WhatsApp Web Plus userscript updates"
msgstr "Periksa dan pasang pembaruan userscript WhatsApp Web Plus"

#. Translators: Command description in NVDA's Input Gestures dialog.
msgid "Diagnose and repair WebView2 policy permissions"
msgstr "Diagnosa dan perbaiki izin kebijakan WebView2"

msgid "Makes WhatsApp Stable and Beta from Microsoft Store easier to use with NVDA, with WhatsApp Web Plus features, keyboard navigation, message reading and call controls."
msgstr "Membuat WhatsApp Stable dan Beta dari Microsoft Store lebih mudah dipakai dengan NVDA, dengan fitur WhatsApp Web Plus, navigasi keyboard, pembacaan pesan, dan kontrol panggilan."

#~ msgid "Launching WhatsApp {channel} with WhatsApp Companion."
#~ msgstr "Meluncurkan WhatsApp {channel} dengan WhatsApp Companion."

#~ msgid "Checking for WhatsApp Web Plus userscript updates. If the official userscript has a newer version or different content, the Companion will download and install it automatically."
#~ msgstr "Memeriksa pembaruan userscript WhatsApp Web Plus. Jika userscript resmi memiliki versi yang lebih baru atau isi yang berbeda, Companion akan mengunduh dan memasangnya secara otomatis."

msgid "Turn the camera on or off in a WhatsApp call"
msgstr "Nyalakan atau matikan kamera dalam panggilan WhatsApp"

msgid "Mute or unmute your microphone in a WhatsApp call"
msgstr "Bisukan atau aktifkan mikrofon dalam panggilan WhatsApp"

msgid "Open reactions in a WhatsApp call"
msgstr "Buka reaksi dalam panggilan WhatsApp"

msgid "Raise or lower your hand in a WhatsApp call"
msgstr "Angkat atau turunkan tangan dalam panggilan WhatsApp"

msgid "Start or stop screen sharing in a WhatsApp call"
msgstr "Mulai atau hentikan berbagi layar dalam panggilan WhatsApp"

msgid "End WhatsApp call"
msgstr "Akhiri panggilan WhatsApp"

msgid "Couldn't tell whether WhatsApp is open, so the check stopped. Try again."
msgstr "Tidak dapat memastikan apakah WhatsApp terbuka, jadi pemeriksaan dihentikan. Coba lagi."

msgid "Call control lab&els..."
msgstr "&Label kontrol panggilan..."

msgid "Customize call control labels for the language used by WhatsApp"
msgstr "Sesuaikan label kontrol panggilan dengan bahasa yang digunakan WhatsApp"

msgid "Call control labels saved."
msgstr "Label kontrol panggilan disimpan."

msgid "Couldn't load call control labels. Your saved labels weren't changed."
msgstr "Tidak dapat memuat label kontrol panggilan. Label yang tersimpan tidak diubah."

msgid "Answer incoming call"
msgstr "Jawab panggilan masuk"

msgid "Decline incoming call"
msgstr "Tolak panggilan masuk"

msgid "Camera on/off"
msgstr "Aktifkan/nonaktifkan kamera"

msgid "Microphone mute/unmute (including compact view)"
msgstr "Bisukan/aktifkan mikrofon (termasuk tampilan kecil)"

msgid "Reactions"
msgstr "Reaksi"

msgid "Raise/lower hand"
msgstr "Angkat/turunkan tangan"

msgid "Start/stop screen sharing"
msgstr "Mulai/hentikan berbagi layar"

msgid "End call"
msgstr "Akhiri panggilan"

msgid "Call control labels"
msgstr "Label kontrol panggilan"

msgid "Add the exact labels NVDA speaks for WhatsApp call buttons, one per line. For on/off buttons, add both states. Built-in labels always work, so you can leave this empty. Changes apply to Stable and Beta after you save."
msgstr "Tambahkan label persis seperti yang diucapkan NVDA untuk tombol panggilan WhatsApp, satu per baris. Untuk tombol nyala/mati, tambahkan kedua keadaannya. Label bawaan selalu berfungsi, jadi bagian ini boleh dikosongkan. Perubahan berlaku untuk Stable dan Beta setelah disimpan."

msgid "&Reset all additional labels"
msgstr "&Hapus semua label tambahan"

msgid "&Save"
msgstr "&Simpan"

msgid "Cancel"
msgstr "Batal"

msgid "Additional labels cleared. Choose Save to apply, or Cancel to keep your saved labels."
msgstr "Label tambahan dikosongkan. Pilih Simpan untuk menerapkan, atau Batal untuk mempertahankan label yang tersimpan."

msgid "&Call action:"
msgstr "&Tindakan panggilan:"

msgid "&Built-in labels (read only):"
msgstr "Label &bawaan (hanya baca):"

msgid "&Additional labels (one per line):"
msgstr "Label t&ambahan (satu per baris):"

msgid "Couldn't save labels for {action}. Use up to 20 labels, each up to 128 characters, and don't use the same label for two actions."
msgstr "Tidak dapat menyimpan label untuk {action}. Gunakan paling banyak 20 label, masing-masing paling panjang 128 karakter, dan jangan memakai label yang sama untuk dua tindakan."

msgid "Couldn't save call control labels. Your changes are still here. Try again."
msgstr "Tidak dapat menyimpan label kontrol panggilan. Perubahan Anda masih ada di sini. Coba lagi."

msgid "&Copy message"
msgstr "&Salin pesan"

msgid "&Formatted view"
msgstr "Tampilan ber&format"

msgid "C&lose"
msgstr "&Tutup"

msgid "Message copied."
msgstr "Pesan disalin."

msgid "Couldn't copy the message."
msgstr "Tidak dapat menyalin pesan."

#. Progress while reconnecting.
msgid "Reconnecting WhatsApp Companion. Please wait."
msgstr "Menyambungkan kembali WhatsApp Companion. Mohon tunggu."

msgid "WhatsApp Companion is connected again."
msgstr "WhatsApp Companion tersambung kembali."

msgid "Couldn't reconnect WhatsApp Companion. Close WhatsApp, then launch it again."
msgstr "Tidak dapat menyambungkan kembali WhatsApp Companion. Tutup WhatsApp, lalu luncurkan lagi."

#. Release summary for WhatsApp Companion 2026.11.07.
msgid "Run WhatsApp Stable and Beta together, connect automatically when WhatsApp opens, and choose which WhatsApp to force close. Fixes launch failures on slow computers. Requires NVDA 2025.1 or later."
msgstr "Jalankan WhatsApp Stable dan Beta bersamaan, sambungkan otomatis saat WhatsApp dibuka, dan pilih WhatsApp yang akan ditutup paksa. Memperbaiki kegagalan peluncuran di komputer yang lambat. Memerlukan NVDA 2025.1 atau yang lebih baru."

#. Call recording.
msgid "Start call &recording..."
msgstr "Mulai &rekam panggilan..."

#. Call recording.
msgid "Record the call and your microphone to a WAV file"
msgstr "Rekam panggilan dan mikrofon Anda ke file WAV"

#. Call recording.
msgid "Sto&p recording"
msgstr "&Hentikan rekaman"

#. Call recording.
msgid "Stop recording and save the WAV file"
msgstr "Hentikan rekaman dan simpan file WAV"

#. Call recording.
msgid "A recording is already running or starting."
msgstr "Rekaman sudah berjalan atau sedang disiapkan."

#. Call recording.
msgid "Call recording requires Windows build 20348 or later."
msgstr "Perekaman panggilan memerlukan Windows build 20348 atau yang lebih baru."

#. Call recording.
msgid "Loading microphones. Please wait."
msgstr "Memuat daftar mikrofon. Mohon tunggu."

#. Call recording.
msgid "Couldn't load microphones. Check microphone access in Windows settings and try again."
msgstr "Tidak dapat memuat mikrofon. Periksa akses mikrofon di pengaturan Windows, lalu coba lagi."

#. Call recording.
msgid "Starting call recording. Please wait."
msgstr "Menyiapkan rekaman panggilan. Mohon tunggu."

#. Call recording.
msgid "Stopping recording and saving the file."
msgstr "Menghentikan rekaman dan menyimpan file."

#. Call recording.
msgid "No call recording is running."
msgstr "Tidak ada rekaman panggilan yang berlangsung."

#. Call recording.
msgid "Call recording started."
msgstr "Rekaman panggilan dimulai."

#. Call recording.
msgid "Recording saved: {path}"
msgstr "Rekaman disimpan: {path}"

#. Call recording.
msgid "Recording cancelled."
msgstr "Rekaman dibatalkan."

#. Call recording.
msgid "Recording stopped because of an error. Part of it may be saved at: {path}"
msgstr "Rekaman berhenti karena kesalahan. Sebagian mungkin tersimpan di: {path}"

#. Call recording.
msgid "Couldn't record the call. Check that the selected WhatsApp is open, the microphone is free and you can save to the folder. No other computer audio was recorded."
msgstr "Tidak dapat merekam panggilan. Pastikan WhatsApp yang dipilih terbuka, mikrofon tidak dipakai aplikasi lain, dan folder bisa ditulisi. Tidak ada suara lain dari komputer yang direkam."

#. Call recording.
msgid "Start WhatsApp call recording"
msgstr "Mulai rekaman panggilan WhatsApp"

#. Call recording.
msgid "Stop WhatsApp call recording"
msgstr "Hentikan rekaman panggilan WhatsApp"

#. Call recording.
msgid "Record WhatsApp call"
msgstr "Rekam panggilan WhatsApp"

#. Call recording.
msgid "Tell everyone in the call before you record. Choose the microphone WhatsApp uses. WhatsApp audio goes to the left channel and your microphone to the right. Your microphone is recorded even when muted in WhatsApp. Recording stops shortly after the call ends, or when you choose Stop recording."
msgstr "Beri tahu semua peserta sebelum merekam. Pilih mikrofon yang dipakai WhatsApp. Suara WhatsApp disimpan di kanal kiri dan mikrofon Anda di kanal kanan. Mikrofon tetap terekam walaupun dibisukan di WhatsApp. Rekaman berhenti sendiri tidak lama setelah panggilan berakhir, atau saat Anda memilih Hentikan rekaman."

#. Call recording.
msgid "&WhatsApp channel:"
msgstr "&Varian WhatsApp:"

#. Call recording.
msgid "&Microphone:"
msgstr "&Mikrofon:"

#. Call recording.
msgid "&Recording folder:"
msgstr "&Folder rekaman:"

#. Call recording.
msgid "&Start recording"
msgstr "&Mulai rekaman"

#. Call recording.
msgid "Enter the full folder path, starting with a drive letter."
msgstr "Masukkan path folder lengkap, diawali huruf drive."

#. Recording availability.
msgid "Checking for a WhatsApp call. Please wait."
msgstr "Mencari panggilan WhatsApp. Mohon tunggu."

#. Recording availability.
msgid "No WhatsApp call found. Open the full call window and try again."
msgstr "Tidak ada panggilan WhatsApp. Buka jendela panggilan penuh, lalu coba lagi."

msgid "Restoring call controls. Release the shortcut keys."
msgstr "Memulihkan kontrol panggilan. Lepaskan tombol shortcut."

msgid "Call controls restored. Press the shortcut again."
msgstr "Kontrol panggilan sudah dipulihkan. Tekan shortcut sekali lagi."

msgid "Couldn't restore call controls. Go to the call window and try again."
msgstr "Tidak dapat memulihkan kontrol panggilan. Buka jendela panggilan, lalu coba lagi."

msgid "Opening the call window to check the call before recording."
msgstr "Membuka jendela panggilan untuk memeriksa panggilan sebelum merekam."

msgid "Call window found. Start will check the call."
msgstr "Jendela panggilan ditemukan. Mulai akan memeriksa panggilan."

msgid "Call window not found. Open the call window, or check which WhatsApp is selected."
msgstr "Jendela panggilan tidak ditemukan. Buka jendela panggilan, atau periksa WhatsApp mana yang dipilih."

msgid "Recording cancelled before it started."
msgstr "Rekaman dibatalkan sebelum dimulai."

#. Translators: The call state check failed or timed out, so no call can be confirmed or ruled out.
msgid "Couldn't check for a WhatsApp call. Try again."
msgstr "Tidak dapat memeriksa panggilan WhatsApp. Coba lagi."

#. Translators: The call state could not be read; Start still checks before recording.
msgid "Couldn't find the call window yet. Start will check again."
msgstr "Jendela panggilan belum ditemukan. Mulai akan memeriksa lagi."

#. Translators: The recorder stopped by itself after the WhatsApp call window closed.
msgid "The call ended. Recording saved: {path}"
msgstr "Panggilan berakhir. Rekaman disimpan: {path}"

#. Translators: The recorder stopped by itself at its maximum length.
msgid "Recording reached the 4-hour limit. Saved: {path}"
msgstr "Rekaman mencapai batas 4 jam. Disimpan: {path}"

#. Translators: Shown for a microphone that Windows reports without a name.
msgid "Unnamed microphone {number}"
msgstr "Mikrofon tanpa nama {number}"

#. Translators: Stop was pressed before capture started; nothing is saved.
msgid "Cancelling the recording."
msgstr "Membatalkan rekaman."

#. Translators: Recording did not start because another window took the foreground.
msgid "Recording didn't start because you left the call window. Stay in the call window and try again."
msgstr "Rekaman tidak dimulai karena Anda meninggalkan jendela panggilan. Tetap di jendela panggilan, lalu coba lagi."

#. Translators: Spoken and brailled when this WhatsApp channel already runs with the Companion.
msgid "WhatsApp {channel} is already running with WhatsApp Companion."
msgstr "WhatsApp {channel} sudah berjalan dengan WhatsApp Companion."

#. Translators: Spoken when a WhatsApp the user just opened is reopened with the Companion.
msgid "Reopening WhatsApp {channel} with WhatsApp Companion. Please wait."
msgstr "Membuka ulang WhatsApp {channel} dengan WhatsApp Companion. Mohon tunggu."

#. Translators: Spoken when a WhatsApp the user just opened could not be closed to reopen it.
msgid "Couldn't reopen WhatsApp {channel}. Close it, then launch it from the WhatsApp Companion menu."
msgstr "Tidak dapat membuka ulang WhatsApp {channel}. Tutup WhatsApp, lalu luncurkan dari menu WhatsApp Companion."

#. Translators: Checkable Tools submenu command. The ampersand marks the mnemonic.
msgid "Connect &automatically when WhatsApp is opened"
msgstr "Hubungkan &otomatis saat WhatsApp dibuka"

msgid "Reopen WhatsApp with WhatsApp Companion when you open it from the Start menu, taskbar or desktop"
msgstr "Buka ulang WhatsApp dengan WhatsApp Companion saat Anda membukanya dari menu Mulai, taskbar, atau desktop"

#. Translators: Spoken when the automatic connection setting cannot be saved.
msgid "Couldn't change automatic connection."
msgstr "Tidak dapat mengubah sambungan otomatis."

#. Translators: Spoken after turning on automatic connection.
msgid "Automatic connection on. When you open WhatsApp, it will reopen with WhatsApp Companion."
msgstr "Sambungan otomatis aktif. Saat Anda membuka WhatsApp, WhatsApp akan dibuka ulang dengan WhatsApp Companion."

#. Translators: Spoken after turning off automatic connection.
msgid "Automatic connection off."
msgstr "Sambungan otomatis nonaktif."

#. Translators: Input gesture description for turning automatic connection on or off.
msgid "Turn automatic WhatsApp Companion connection on or off"
msgstr "Aktifkan atau nonaktifkan sambungan otomatis WhatsApp Companion"

#. Translators: Tools submenu command. The ellipsis is required because activation shows a dialog.
msgid "&Force close Microsoft Store WhatsApp processes..."
msgstr "&Tutup paksa proses WhatsApp dari Microsoft Store..."

msgid "Close WhatsApp Stable, Beta or both when they won't close normally"
msgstr "Tutup WhatsApp Stable, Beta, atau keduanya jika tidak bisa ditutup seperti biasa"

#. Translators: Command description in NVDA's Input Gestures dialog.
msgid "Force close Microsoft Store WhatsApp Stable, Beta or both"
msgstr "Tutup paksa WhatsApp Stable, Beta, atau keduanya dari Microsoft Store"

#. Translators: Immediate progress after the user confirms force closing one WhatsApp channel.
msgid "Closing WhatsApp {channel}."
msgstr "Menutup WhatsApp {channel}."

#. Translators: Result when the selected Microsoft Store WhatsApp channel was not running.
msgid "WhatsApp {channel} wasn't running."
msgstr "WhatsApp {channel} tidak sedang berjalan."

#. Translators: Result after every process of the selected Microsoft Store WhatsApp channel was closed.
msgid "WhatsApp {channel} was closed ({closedCount} processes)."
msgstr "WhatsApp {channel} sudah ditutup ({closedCount} proses)."

#. Translators: Title of the dialog that force closes Microsoft Store WhatsApp.
msgid "Force close WhatsApp"
msgstr "Tutup paksa WhatsApp"

#. Translators: Warning in the force-close dialog.
msgid "The selected WhatsApp closes right away. Calls and file transfers will stop, and unsent text may be lost."
msgstr "WhatsApp yang dipilih langsung ditutup. Panggilan dan transfer file akan berhenti, dan teks yang belum dikirim bisa hilang."

#. Translators: Label of the radio buttons that choose which WhatsApp to force close.
msgid "WhatsApp to &close"
msgstr "WhatsApp yang akan &ditutup"

#. Translators: Force-close choice for WhatsApp Stable only.
msgid "WhatsApp Stable"
msgstr "WhatsApp Stable"

#. Translators: Force-close choice for WhatsApp Beta only.
msgid "WhatsApp Beta"
msgstr "WhatsApp Beta"

#. Translators: Force-close choice for both WhatsApp Stable and WhatsApp Beta.
msgid "All (Stable and Beta)"
msgstr "Semua (Stable dan Beta)"
